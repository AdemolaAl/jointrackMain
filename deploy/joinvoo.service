# Copy to /etc/systemd/system/joinvoo.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now joinvoo
[Unit]
Description=Joinvoo
After=network-online.target
Wants=network-online.target

[Service]
User=joinvoo
WorkingDirectory=/opt/joinvoo
EnvironmentFile=/opt/joinvoo/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
