# ---- Required ----
# Your public https address. Telegram only talks to https.
BASE_URL=https://joinvoo.com
# Optional: separate domain for ad tracking links (e.g. https://gojoinly.com). Can also be set in Admin → Settings → Link domains.
LINK_BASE_URL=
# Where the database lives. Must be persistent storage (a Railway volume, or a folder on your VPS).
DATA_DIR=/data
# Your email(s). These accounts can open /admin. Comma-separated.
ADMIN_EMAILS=you@example.com
NODE_ENV=production
PORT=3000

# ---- Most settings are edited in /admin → Settings (pricing, feature switches, payment methods, support team, brand). ----
# The values below are only the starting defaults. Anything saved in /admin wins over them.

# ---- Payments (turn on the ones you use; you can also add/edit these later in /admin → Settings → Payment methods) ----
# Stripe and Paystack keys are added per payment method in /admin (see DEPLOY.md). The ones below are the older global setup.
# Paystack: Settings → API Keys & Webhooks. Webhook URL: https://joinvoo.com/webhooks/paystack
PAYSTACK_SECRET=
PAYSTACK_CURRENCY=NGN
# Flutterwave: Settings → API keys. Webhooks: URL https://joinvoo.com/webhooks/flutterwave, and set a "Secret hash".
FLW_SECRET=
FLW_WEBHOOK_HASH=
FLW_CURRENCY=USD
# Naira per dollar for NGN charges. Update it when the rate moves.
NGN_PER_USD=1600
# Your USDT (TRC20) wallet for crypto top-ups (creates the USDT method on first start). More wallets or bank transfer: add them in /admin.
USDT_TRC20_ADDRESS=

# ---- Email (password resets, welcome, payout notices) ----
# Free at resend.com. Verify your domain there first. Without a key, reset links are printed in the server log.
RESEND_API_KEY=
# (can also be set or overridden in /admin → Settings → Integrations & API keys, like ANTHROPIC_API_KEY)
# The sender address. The display name ("Joinvoo") and the support/reply-to email can be changed in /admin → Settings → Brand & emails.
MAIL_FROM=Joinvoo <hello@joinvoo.com>
# SUPPORT_EMAIL=support@joinvoo.com
# EMAIL_WEEKLY_SUMMARY=false

# ---- Cloudflare ----
# Set to 1 ONLY if your domain is proxied through Cloudflare (orange cloud). Then visitor IP + country come from Cloudflare.
TRUST_CLOUDFLARE=0

# ---- Support ----
# Optional: get a Telegram ping for every new live-chat message. Make a bot in @BotFather, send it a message, and put your chat id here.
SUPPORT_TG_BOT_TOKEN=
SUPPORT_TG_CHAT_ID=
# Shown in the dashboard Help tab and on legal pages. A Telegram link or an email link. (Also editable in /admin, with your team, photos and hours.)
SUPPORT_CONTACT=https://t.me/your_support_username
# SUPPORT_HOURS=Mon–Sat, 8am–10pm
# SUPPORT_REPLY_TIME=Usually replies in a few minutes

# ---- Telegram alerts (optional) ----
# A bot made just for Joinvoo alerts (morning summary at 08:00 in each customer's time zone, broken tokens, links running low, no joins for 2 hours,
# campaigns without deposits today). Leave empty to show "Coming soon".
ALERT_BOT_TOKEN=

# ---- Joe, the assistant (optional) ----
# With a key, Joe's chat answers with AI (Anthropic Messages API). Without it he answers from each customer's numbers and joe/knowledge.md.
# The key can also be pasted in /admin → Settings → Joe (stored masked). A key saved there wins.
ANTHROPIC_API_KEY=
# JOE_MODEL=claude-haiku-4-5-20251001
# JOE_DAILY_LIMIT=30        # questions per customer per day
# ANTHROPIC_API_BASE=https://api.anthropic.com
# FEATURE_JOE=true

# ---- Pricing defaults (change them any time in /admin → Settings → Pricing) ----
# PRICE_BASE_CENTS=3000
# PRICE_INCLUDED=2000
# PRICE_PER_CENTS=2
# FREE_JOINS=500          # free tracked joins for each new account (worth $10 at 2¢)
# WELCOME_CREDIT_CENTS=0  # optional extra wallet credit on signup
# MIN_DEPOSIT_CENTS=1000
# WITHDRAW_MIN_CENTS=30000
# REF_HOLD_DAYS=14       # referral earnings settle this many days before they can be withdrawn
# BILLING=off            # turn billing off completely (e.g. private use)
# Pro plan and trial (Basic = the PRICE_* values above). Edit in /admin → Settings → Plans & trial.
# PRO_BASE_CENTS=9900
# PRO_INCLUDED=5000
# PRO_PER_CENTS=2
# TRIAL_DAYS=7
# TRIAL_FTDS=20           # trial ends after this many attributed first deposits, or after TRIAL_DAYS
# TRIAL_STARTS=first_ftd  # or signup

# ---- Other ----
# Feature switch defaults (also switchable in /admin → Settings → Features):
# ALLOW_SIGNUP=true
# FEATURE_REFERRALS=true
# FEATURE_WITHDRAWALS=true
# FEATURE_TIKTOK=true
# FEATURE_SNAPCHAT=true
# FEATURE_SUPPORT_CHAT=true
# FEATURE_FTD=true
# FEATURE_BOT_NO_TOKEN=true
# FEATURE_INTEGRATIONS=true
# FEATURE_JOIN_REQUESTS=true
# FEATURE_SPEND=true
# FEATURE_FAKE_FILTER=true
# FEATURE_CREDITS_BONUS=true
# FEATURE_RANKS=true
# FEATURE_ENTERPRISE=true
# COMPANY_NAME=Zedapex
# APP_SECRET=            # optional; otherwise generated and kept in DATA_DIR/.secret

# ---- Testing only: point Paystack / Stripe calls at a fake server ----
# PAYSTACK_API_BASE=http://localhost:4300
# STRIPE_API_BASE=http://localhost:4300

# ---- VooSquare: one login for all Zedapex tools (all optional; nothing changes until you set these) ----
# Can also be set in /admin → Settings → Integrations & API keys → VooSquare (values saved there win). See UPGRADE.md.
# VOO_ISSUER=https://voosquare.com   # the VooSquare address (its /oauth/authorize, /oauth/token, /api/v1/events live here)
# VOO_CLIENT_ID=
# VOO_CLIENT_SECRET=
# Login mode: off (default) | both (password + "Continue with VooSquare") | only (VooSquare only; staff keep /login?local=1)
# VOO_LOGIN_MODE=off
# VOO_REDIRECT_URI=          # default ${BASE_URL}/auth/voosquare/callback
# VOO_SERVICE_KEY=           # VooSquare sends this to read /api/voosquare/summary
# VOO_WEBHOOK_SECRET=        # signs the events Joinvoo sends to VooSquare (X-Voo-Signature)
# VOO_API_KEY=               # the API key VooSquare gives Joinvoo (Admin → Products → Joinvoo). Events, summary and support use it
# VOO_EVENTS_URL=            # default <VOO_ISSUER>/api/v1/events
# VOO_SUPPORT_BRIDGE=0       # 1 = copy support chats to the VooSquare HQ inbox and show replies made there
# VOO_AFFILIATE_URL=https://affiliate.voosquare.com
# VOO_HOME=https://voosquare.com
# VOO_REFERRALS=local        # local | voosquare

# ---- Joe's AI provider (optional; also in /admin → Settings → Joe, where saved values win) ----
# JOE_PROVIDER=anthropic           # anthropic (default) | openai (any OpenAI-compatible Chat Completions API)
# JOE_MODEL=claude-haiku-4-5-20251001   # Anthropic model; claude-sonnet-4-5 gives deeper advice at a higher cost
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # e.g. https://openrouter.ai/api/v1
# JOE_OPENAI_MODEL=gpt-4o-mini

# --- Plan limits (round 11). Also editable in /admin → Settings → Plans & trial → Plan limits. 0 = unlimited.
# BASIC_MAX_CHANNELS=3
# BASIC_MAX_BOTS=3
# PRO_MAX_CHANNELS=0
# PRO_MAX_BOTS=0
# FEATURE_LINK_NAMES=1       # name each invite link after its click ("Meta · c-0a3f9 · NG") in Telegram

# --- Gatevoo crypto checkout (USDT + Bitcoin). Optional: you can also paste these in /admin → Settings → Payment methods → Gatevoo.
# GATEVOO_URL=https://gatevoo.com
# GATEVOO_API_KEY=
# GATEVOO_WEBHOOK_SECRET=
